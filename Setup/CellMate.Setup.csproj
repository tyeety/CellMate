<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CellMateSetup</AssemblyName>
    <Version>0.2.1</Version>
    <Product>CellMate</Product>
    <Company>ShatootSoft</Company>
    <Description>CellMate for Excel - Setup</Description>
    <ApplicationIcon>../Assets/CellMate.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath>../dist/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../Theme.cs" Link="Theme.cs" />
    <Compile Include="../Brand.cs" Link="Brand.cs" />
    <EmbeddedResource Include="../Assets/CellMate.ico" LogicalName="CellMate.ico" />
    <EmbeddedResource Include="../LICENSE" LogicalName="CellMate.License" />
    <EmbeddedResource Include="../THIRD_PARTY_NOTICES.md" LogicalName="CellMate.ThirdPartyNotices" />
    <EmbeddedResource Include="../bin/Release/net48/publish/CellMate-AddIn-packed.xll" LogicalName="CellMate.x86" />
    <EmbeddedResource Include="../bin/Release/net48/publish/CellMate-AddIn64-packed.xll" LogicalName="CellMate.x64" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
